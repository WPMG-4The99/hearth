<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug overlay of src/main/res/xml/shortcuts.xml.
  applicationIdSuffix makes this install io.github.nanomuse.app.hearth, so the
  long-press shortcuts must target that package. Release keeps the unsuffixed id.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_chat"
        android:enabled="true"
        android:icon="@mipmap/ic_shortcut_new_chat"
        android:shortcutShortLabel="@string/shortcut_new_chat_short"
        android:shortcutLongLabel="@string/shortcut_new_chat_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="io.github.nanomuse.app.hearth"
            android:targetClass="com.openminis.app.MainActivity"
            android:data="minis://action/new_chat" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
    <shortcut
        android:shortcutId="voice_chat"
        android:enabled="true"
        android:icon="@mipmap/ic_shortcut_voice_chat"
        android:shortcutShortLabel="@string/shortcut_voice_chat_short"
        android:shortcutLongLabel="@string/shortcut_voice_chat_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="io.github.nanomuse.app.hearth"
            android:targetClass="com.openminis.app.MainActivity"
            android:data="minis://action/voice_chat" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
    <shortcut
        android:shortcutId="camera_chat"
        android:enabled="true"
        android:icon="@mipmap/ic_shortcut_camera_chat"
        android:shortcutShortLabel="@string/shortcut_camera_chat_short"
        android:shortcutLongLabel="@string/shortcut_camera_chat_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="io.github.nanomuse.app.hearth"
            android:targetClass="com.openminis.app.MainActivity"
            android:data="minis://action/camera_chat" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
</shortcuts>
